{
  "name": "require-security-scan",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH", "refs/heads/main", "refs/heads/master"],
      "exclude": []
    },
    "repository_name": {
      "include": ["~ALL"],
      "exclude": ["security-workflows"],
      "protected": false
    }
  },
  "rules": [
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          {
            "repository_id": REPO_ID,
            "path": ".github/workflows/security-scan.yml",
            "ref": "refs/heads/main"
          }
        ]
      }
    }
  ]
}
